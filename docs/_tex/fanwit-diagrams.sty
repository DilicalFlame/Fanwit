\newcommand{\wficm}[3]{\node[anchor=center,text=wfMuted] at (#1,#2) {\faIcon{#3}};}
\newcommand{\wficb}[3]{\node[anchor=center,text=fwBrand] at (#1,#2) {\faIcon{#3}};}
