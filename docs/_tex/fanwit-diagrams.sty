  \node[anchor=west,text=wfMuted] at (#1+1.5,#2+2.5) {\faIcon{search}\ #4};}
\newcommand{\wfselect}[4]{%
  \filldraw[draw=wfLine,fill=white,rounded corners=0.8,line width=0.35pt] (#1,#2) rectangle ++(#3,5);
  \node[anchor=west] at (#1+1.2,#2+2.5) {#4};
  \node[anchor=east] at (#1+#3-1,#2+2.5) {\faIcon{chevron-down}};}
\newcommand{\wfchk}[4]{%
  \ifnum#3=1 \filldraw[draw=fwBrand,fill=fwBrand,rounded corners=0.4] (#1,#2-1.2) rectangle ++(2.4,2.4);
    \node[text=white,font=\fontsize{3.5}{3.5}\selectfont] at (#1+1.2,#2) {\faIcon{check}};
  \else \draw[wfLine,rounded corners=0.4,line width=0.35pt] (#1,#2-1.2) rectangle ++(2.4,2.4); \fi
  \node[anchor=west] at (#1+3.4,#2) {#4};}
\newcommand{\wftog}[3]{%
  \ifnum#3=1 \filldraw[fill=fwBrand,draw=fwBrand,rounded corners=1.3] (#1,#2-1.3) rectangle ++(5,2.6);
    \fill[white] (#1+3.7,#2) circle (1);
  \else \filldraw[fill=wfFillDark,draw=wfLine,rounded corners=1.3,line width=0.3pt] (#1,#2-1.3) rectangle ++(5,2.6);
    \fill[white] (#1+1.3,#2) circle (1); \draw[wfLine,line width=0.2pt] (#1+1.3,#2) circle (1);\fi}
\newcommand{\wfslider}[4]{%
  \draw[wfFillDark,line width=1pt] (#1,#2) -- ++(#3,0);
  \draw[fwBrand,line width=1pt] (#1,#2) -- ++(#4,0);
  \filldraw[fill=white,draw=fwBrand,line width=0.4pt] (#1+#4,#2) circle (1.2);}
\newcommand{\wfkey}[3]{\node[draw=wfLine,fill=white,rounded corners=0.6,inner sep=0.8pt,
  font=\ttfamily\fontsize{4.6}{5}\selectfont,anchor=west] at (#1,#2) {#3};}
\newcommand{\wfkeyr}[3]{\node[draw=wfLine,fill=white,rounded corners=0.6,inner sep=0.8pt,
  font=\ttfamily\fontsize{4.6}{5}\selectfont,anchor=east] at (#1,#2) {#3};}
\newcommand{\wftab}[5]{%
  \ifnum#5=1
    \filldraw[draw=wfLine!70,fill=white,line width=0.3pt] (#1,#2+5.5) -- (#1,#2) -- ++(#3,0) -- ++(0,5.5);
    \draw[fwBrand,line width=0.9pt] (#1,#2) -- ++(#3,0);
    \node[anchor=west,font=\sffamily\tiny\bfseries] at (#1+1.5,#2+2.75) {#4};
  \else
    \draw[wfLine!50,line width=0.3pt] (#1+#3,#2+1) -- ++(0,3.5);
    \node[anchor=west,text=wfMuted] at (#1+1.5,#2+2.75) {#4};
  \fi
  \node[anchor=east,text=wfMuted,font=\fontsize{3.5}{3.5}\selectfont] at (#1+#3-1.2,#2+2.75) {\faIcon{times}};}
\newcommand{\wflines}[4]{%
  \foreach \i in {1,...,#4}{\draw[wfFillDark,line width=1.1pt] (#1,#2+\i*2.8-2.8) -- ++({#3*(0.55+0.45*mod(\i*37,10)/10)},0);}}
\newcommand{\wfsep}[3]{\draw[wfLine!40,line width=0.3pt] (#1,#2) -- ++(#3,0);}
\newcommand{\wfvsep}[3]{\draw[wfLine!40,line width=0.3pt] (#1,#2) -- ++(0,#3);}
\newcommand{\wfavatar}[3]{\filldraw[fill=wfFillDark,draw=wfLine,line width=0.3pt] (#1,#2) circle (#3);}
\newcommand{\wfsel}[4]{\fill[fwBrand!12] (#1,#2) rectangle ++(#3,#4);
  \fill[fwBrand] (#1,#2) rectangle ++(0.6,#4);}
\newcommand{\wfprogress}[4]{%
  \fill[wfFillDark,rounded corners=0.5] (#1,#2) rectangle ++(#3,1.2);
  \fill[fwBrand,rounded corners=0.5] (#1,#2) rectangle ++(#4,1.2);}
\newcommand{\wfswatch}[4]{\filldraw[fill=#3,draw=wfLine!60,line width=0.25pt] (#1,#2) circle (#4);}
\newcommand{\wfcursor}[2]{\fill[black] (#1,#2) -- ++(0,3.4) -- ++(0.9,-0.9) -- ++(0.9,1.6) -- ++(0.5,-0.3)
  -- ++(-0.9,-1.5) -- ++(1.3,0) -- cycle; \draw[white,line width=0.15pt] (#1,#2) -- ++(0,3.4) -- ++(0.9,-0.9)
  -- ++(0.9,1.6) -- ++(0.5,-0.3) -- ++(-0.9,-1.5) -- ++(1.3,0) -- cycle;}
% numbered callout for the element legend under a wireframe
\newcommand{\wfnum}[3]{\node[circle,fill=fwWarm,text=white,font=\sffamily\fontsize{4.2}{4.2}\selectfont\bfseries,
  inner sep=0pt,minimum size=3.3mm] at (#1,#2) {#3};}
% numbered legend list
\newenvironment{wflegend}{%
  \begin{enumerate}[label={\protect\tikz[baseline=-0.6ex]\protect\node[circle,fill=fwWarm,text=white,
    font=\sffamily\scriptsize\bfseries,inner sep=0pt,minimum size=4mm]{\arabic*};},
    leftmargin=9mm,itemsep=1pt,font=\small]\small}{\end{enumerate}}

% standard app chrome pieces ---------------------------------------------
% custom title bar of the workbench (x,y,w)
\newcommand{\wftitlebar}[3]{%
  \wfdark{#1}{#2}{#3}{7}
  \begin{scope}[shift={(#1+1.5,#2+1.5)},x=0.4mm,y=-0.4mm]\fill[fwInk] (0,0) rectangle (10,10);
    \fill[fwBrandSoft] (1,1) rectangle (3.4,7.6);\fill[fwAccent] (3.9,1) rectangle (9,2.6);\end{scope}
  \wft{#1+7}{#2+3.5}{File\ \ Edit\ \ View\ \ Go\ \ Window\ \ Help}
  \filldraw[draw=wfLine,fill=white,rounded corners=1.5,line width=0.3pt] (#1+#3/2-22,#2+1.2) rectangle ++(44,4.6);
  \node[text=wfMuted] at (#1+#3/2,#2+3.5) {\faIcon{search}\ \ Search or run a command\ \ \ \ \ Ctrl+K};
  \node[anchor=center] at (#1+#3-13,#2+3.5) {\faIcon{window-minimize}};
  \node[anchor=center] at (#1+#3-8,#2+3.5) {\faIcon[regular]{square}};
  \node[anchor=center] at (#1+#3-3,#2+3.5) {\faIcon{times}};}
% status bar (x,y,w)
\newcommand{\wfstatusbar}[3]{%
  \fill[fwBrand] (#1,#2) rectangle ++(#3,4);
  \node[anchor=west,text=white,font=\fontsize{4.3}{4.5}\selectfont] at (#1+1.5,#2+2)
    {\faIcon{database}\ my-vault\quad\faIcon{code-branch}\ main\quad\faIcon{sync}\ Saved};
  \node[anchor=east,text=white,font=\fontsize{4.3}{4.5}\selectfont] at (#1+#3-1.5,#2+2)
    {Ln 12, Col 4\quad UTF-8\quad\faIcon{bell}\ 2};}
% activity bar (x,y,h) with icons
\newcommand{\wfactivity}[3]{%
  \wfdark{#1}{#2}{7}{#3}
  \wfsel{#1}{#2+1}{7}{6}
  \wficb{#1+3.5}{#2+4}{copy}
  \wfic{#1+3.5}{#2+11}{search}
  \wfic{#1+3.5}{#2+18}{terminal}
  \wfic{#1+3.5}{#2+25}{puzzle-piece}
  \wfic{#1+3.5}{#2+32}{book}
  \wfic{#1+3.5}{#2+#3-11}{user-circle}
  \wfic{#1+3.5}{#2+#3-4}{cog}}
