% ---------------------------------------------------------------- inline helpers
\newcommand{\fw}{\textsc{Fanwit}}
\newcommand{\cd}[1]{\texttt{\color{fwInk}#1}}
\newcommand{\flag}[1]{\texttt{\color{fwInk}-{}-#1}}
\DeclareRobustCommand{\key}[1]{\tikz[baseline=(k.base)]\node[draw=fwSlate,fill=fwPaper,rounded corners=1.5pt,
  inner sep=1.6pt,font=\ttfamily\scriptsize](k){#1};}
\DeclareRobustCommand{\pill}[2][fwBrand]{\tikz[baseline=(p.base)]\node[fill=#1!15,text=#1!70!black,rounded corners=4pt,
  inner xsep=4pt,inner ysep=1.5pt,font=\scriptsize\bfseries](p){#2};}
\newcommand{\status}[1]{%
  \ifnum#1=0 \pill[fwGreen]{BUILT}\fi
  \ifnum#1=1 \pill[fwWarm]{PARTIAL}\fi
  \ifnum#1=2 \pill[fwRed]{TO BUILD}\fi
  \ifnum#1=3 \pill[fwBrand]{NEW IDEA}\fi}
\newcommand{\desk}{\pill[fwBrand]{DESKTOP}}
\newcommand{\web}{\pill[fwAccent]{WEB}}
\newcommand{\both}{\pill[fwSlate]{BOTH}}


% ---------------------------------------------------------------- tikz styles
\tikzset{
  fwnode/.style={draw=fwInk!70,fill=white,rounded corners=2pt,font=\small,align=center,
    inner sep=4pt,minimum height=7mm,execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  fwcore/.style={fwnode,fill=fwBrandSoft,draw=fwBrand},
  fwhost/.style={fwnode,fill=fwAccentSoft,draw=fwAccent},
  fwwarm/.style={fwnode,fill=fwWarmSoft,draw=fwWarm},
  fwuser/.style={fwnode,fill=fwGreenSoft,draw=fwGreen},
  fwgrey/.style={fwnode,fill=fwPaper,draw=fwSlate},
  fwarrow/.style={-{Stealth[length=2.2mm]},draw=fwInk!70,thick},
  fwdash/.style={-{Stealth[length=2mm]},draw=fwSlate,dashed},
  fwlabel/.style={font=\scriptsize\color{fwSlate},align=center},
  layer/.style={draw=fwGrid,fill=fwPaper,rounded corners=4pt,inner sep=6pt},
}

% ==========================================================================
%  FANWIT mock logo (pure TikZ)
%  The mark is a window whose panes are split so that they spell an "F":
%  a docked sidebar (stem), a tab strip (top arm), a split pane (middle arm)
%  and one small floating card. It literally shows what the Layout API does.
% ==========================================================================
\newcommand{\fanwitmarkbody}[1]{%
  % window body
  \fill[fwInk] (0,0) rectangle (10,10);
  % title bar dots
  \fill[fwRed!80!white]   (1.15,8.85) circle (0.42);
  \fill[fwWarm!90!white]  (2.35,8.85) circle (0.42);
  \fill[fwAccent!80!white](3.55,8.85) circle (0.42);
  % F: stem (docked sidebar)
  \fill[fwBrandSoft, rounded corners={0.6*#1 mm}] (1.0,1.0) rectangle (3.4,7.6);
  % F: top arm (tab strip)
  \fill[fwAccent, rounded corners={0.6*#1 mm}] (3.9,5.9) rectangle (9.0,7.6);
  % F: middle arm (split pane)
  \fill[fwBrand!70!white, rounded corners={0.6*#1 mm}] (3.9,3.6) rectangle (7.4,5.4);
  % floating card
  \fill[fwWarm, rounded corners={0.5*#1 mm}] (7.0,1.0) rectangle (9.0,2.8);
}
% \fanwitmark{scale}: scale 1 = 1cm wide
\newcommand{\fanwitmark}[1]{%
  \tikz[baseline={(0,0.18*#1 cm)},x=#1 mm,y=#1 mm]{%
    \begin{scope}
      \clip[rounded corners=2.2*#1 mm] (0,0) rectangle (10,10);
      \fanwitmarkbody{#1}
    \end{scope}}}
% big version with soft shadow, for the title page
\newcommand{\fanwitmarkbig}[1]{%
  \tikz[x=#1 mm,y=#1 mm]{%
    \fill[fwInk!25,rounded corners=2.2*#1 mm] (0.35,-0.45) rectangle (10.35,9.55);
    \begin{scope}
      \clip[rounded corners=2.2*#1 mm] (0,0) rectangle (10,10);
      \fanwitmarkbody{#1}
    \end{scope}}}
% \fanwitwordmark{mark scale}{font size in pt}
\newcommand{\fanwitwordmark}[2]{%
  \fanwitmark{#1}\hspace{0.3em}%
  {\fontsize{#2}{#2}\selectfont\bfseries\color{fwInk}fan\color{fwBrand}wit}}

% ==========================================================================
%  Wireframe kit (TikZ). Origin is top left, units are millimetres,
%  y grows downward like screen coordinates. Every macro takes
%  x, y (top left) and usually w, h.
% ==========================================================================
\newenvironment{wf}[1][1]{%
  \begin{tikzpicture}[x=#1 mm,y=-#1 mm,font=\sffamily\tiny,
    every node/.style={text=wfText,inner sep=0.6pt},line cap=round,line join=round]}%
  {\end{tikzpicture}}

% desktop window frame with title bar
\newcommand{\wfwin}[5]{%
  \fill[black!12,rounded corners=1.6] (#1+0.8,#2+1) rectangle ++(#3,#4);
  \filldraw[draw=wfLine,fill=white,rounded corners=1.6,line width=0.5pt] (#1,#2) rectangle ++(#3,#4);
  \fill[wfFillDark,rounded corners=1.6] (#1,#2) rectangle ++(#3,6);
  \fill[wfFillDark] (#1,#2+3) rectangle ++(#3,3);
  \draw[wfLine,line width=0.3pt] (#1,#2+6) -- ++(#3,0);
  \draw[wfLine,line width=0.5pt,rounded corners=1.6] (#1,#2) rectangle ++(#3,#4);
  \node[anchor=center,font=\sffamily\tiny\bfseries] at (#1+#3/2,#2+3) {#5};
  \node[anchor=center,font=\tiny] at (#1+#3-13,#2+3) {\faIcon{window-minimize}};
  \node[anchor=center,font=\tiny] at (#1+#3-8,#2+3) {\faIcon[regular]{square}};
  \node[anchor=center,font=\tiny] at (#1+#3-3,#2+3) {\faIcon{times}};
}
% desktop window frame without OS controls (custom title bar drawn by app)
\newcommand{\wfframe}[4]{%
  \fill[black!12,rounded corners=1.6] (#1+0.8,#2+1) rectangle ++(#3,#4);
  \filldraw[draw=wfLine,fill=white,rounded corners=1.6,line width=0.5pt] (#1,#2) rectangle ++(#3,#4);
}
% browser frame for web target
\newcommand{\wfweb}[5]{%
  \fill[black!12,rounded corners=1.6] (#1+0.8,#2+1) rectangle ++(#3,#4);
  \filldraw[draw=wfLine,fill=white,rounded corners=1.6,line width=0.5pt] (#1,#2) rectangle ++(#3,#4);
  \fill[wfFillDark,rounded corners=1.6] (#1,#2) rectangle ++(#3,8);
  \fill[wfFillDark] (#1,#2+4) rectangle ++(#3,4);
  \draw[wfLine,line width=0.3pt] (#1,#2+8) -- ++(#3,0);
  \fill[red!50] (#1+3,#2+4) circle (0.9); \fill[orange!60] (#1+6,#2+4) circle (0.9);
  \fill[green!50!black!50] (#1+9,#2+4) circle (0.9);
  \filldraw[draw=wfLine,fill=white,rounded corners=1.5,line width=0.3pt] (#1+14,#2+1.8) rectangle ++(#3-20,4.4);
  \node[anchor=west,text=wfMuted] at (#1+16,#2+4) {\faIcon{lock}\ #5};
  \draw[wfLine,line width=0.5pt,rounded corners=1.6] (#1,#2) rectangle ++(#3,#4);
}
\newcommand{\wfrect}[4]{\filldraw[draw=wfLine!60,fill=wfFill,line width=0.3pt] (#1,#2) rectangle ++(#3,#4);}
\newcommand{\wfdark}[4]{\filldraw[draw=wfLine!60,fill=wfFillDark,line width=0.3pt] (#1,#2) rectangle ++(#3,#4);}
\newcommand{\wfwhite}[4]{\filldraw[draw=wfLine!60,fill=white,line width=0.3pt] (#1,#2) rectangle ++(#3,#4);}
\newcommand{\wfcard}[4]{\fill[black!10,rounded corners=1.2] (#1+0.6,#2+0.8) rectangle ++(#3,#4);
  \filldraw[draw=wfLine,fill=white,rounded corners=1.2,line width=0.4pt] (#1,#2) rectangle ++(#3,#4);}
\newcommand{\wfarea}[5]{%
  \draw[wfMuted,dashed,line width=0.3pt] (#1,#2) rectangle ++(#3,#4);
  \node[text=wfMuted,align=center,font=\sffamily\tiny] at (#1+#3/2,#2+#4/2) {#5};}
\newcommand{\wfimg}[4]{%
  \filldraw[draw=wfMuted,fill=wfFill,line width=0.3pt] (#1,#2) rectangle ++(#3,#4);
  \draw[wfMuted,line width=0.2pt] (#1,#2) -- ++(#3,#4) (#1+#3,#2) -- ++(-#3,#4);}
\newcommand{\wfbackdrop}[4]{\fill[black,opacity=0.18] (#1,#2) rectangle ++(#3,#4);}
% text
\newcommand{\wft}[3]{\node[anchor=west] at (#1,#2) {#3};}
\newcommand{\wftb}[3]{\node[anchor=west,font=\sffamily\tiny\bfseries] at (#1,#2) {#3};}
\newcommand{\wfth}[3]{\node[anchor=west,font=\sffamily\scriptsize\bfseries] at (#1,#2) {#3};}
\newcommand{\wftm}[3]{\node[anchor=west,text=wfMuted] at (#1,#2) {#3};}
\newcommand{\wftr}[3]{\node[anchor=east,text=wfMuted] at (#1,#2) {#3};}
\newcommand{\wftc}[3]{\node[anchor=center] at (#1,#2) {#3};}
