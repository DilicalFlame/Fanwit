{
	"$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Fanwit Setup",
	"mainBinaryName": "fanwit-setup",
	"version": "0.1.0",
	"identifier": "com.dilicalflame.fanwit.setup",
	"build": {
		"frontendDist": "../../src-setup/dist",
		"devUrl": "http://localhost:3100",
		"beforeDevCommand": "pnpm exec vite --config src-setup/vite.config.ts",
		"beforeBuildCommand": "pnpm exec vite build --config src-setup/vite.config.ts"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{ "label": "setup", "title": "Setup", "width": 820, "height": 560, "resizable": false, "center": true, "visible": true }
		],
		"security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost" }
	},
	"bundle": { "active": false, "icon": ["../icons/32x32.png", "../icons/128x128.png", "../icons/icon.ico", "../icons/icon.icns"] }
}
