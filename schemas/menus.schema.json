{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fanwit menus.toml",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "patch": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "location",
          "op",
          "item"
        ],
        "additionalProperties": false,
        "properties": {
          "location": {
            "type": "string"
          },
          "op": {
            "enum": [
              "hide",
              "show",
              "move",
              "rename",
              "icon",
              "regroup",
              "insert",
              "props",
              "pin",
              "when"
            ]
          },
          "item": {
            "type": [
              "string",
              "object"
            ]
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "props": {
            "type": "object"
          },
          "when": {
            "type": "string",
            "description": "Context key expression"
          }
        }
      }
    },
    "location": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
