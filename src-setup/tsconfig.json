{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"$lib": ["../src/lib"],
			"$lib/*": ["../src/lib/*"],
			"$fanwit": ["../src/fanwit"],
			"$fanwit/*": ["../src/fanwit/*"]
		}
	},
	"include": ["./**/*.ts", "./**/*.svelte"],
	"exclude": ["dist"]
}
